# Production frontend Auth0 config — baked into the build by `npm run build` / `make build-and-zip`.
# These are PUBLIC values (they ship in the browser bundle), not secrets:
#   - the prod Auth0 tenant domain
#   - the prod "City Budgets" SPA client id
# Committed so a prod build always targets the prod tenant. Without this, a build picks up
# whatever .env.local happens to be on the builder's machine — which once shipped the dev
# tenant + a placeholder client id to production and broke login.
REACT_APP_AUTH0_DOMAIN_ID=budget-planner-prod.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=vx8wn0GMUvdZtsEJGNNhatHliZ809gZI
